{
  "manifest_version": 3,
  "name": "NovelFrance Tools",
  "version": "2.4.4",
  "description": "Outils pour novelfrance.fr : volume TTS, progression de lecture, auto-scroll et navigation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NovelFrance Tools",
    "default_popup": "ui/popup/popup.html"
  },
  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "scripting", "notifications"],
  "host_permissions": ["https://novelfrance.fr/*", "https://*.novelfrance.fr/*"]
}
